# EchoLink credentials — required (licensed amateur radio callsign only)
ECHOLINK_CALLSIGN=N0CALL
ECHOLINK_PASSWORD=your_echolink_password

# TTS/STT backends: openai (default) | elevenlabs | kokoro
TTS_BACKEND=openai
STT_BACKEND=openai

# OpenAI (used for default TTS and STT)
OPENAI_API_KEY=sk-...

# ElevenLabs (only if TTS_BACKEND=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Voice for TTS (OpenAI: alloy, echo, fable, onyx, nova, shimmer)
TTS_VOICE=alloy

# EchoLink directory server (default is correct for most users)
ECHOLINK_SERVER=naeast.echolink.org
ECHOLINK_PORT=5200
